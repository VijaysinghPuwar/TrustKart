# Copy to .env for local development. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# PostgreSQL
TRUSTKART_DB_URL=jdbc:postgresql://localhost:5433/trustkart
TRUSTKART_DB_USER=trustkart
TRUSTKART_DB_PASSWORD=change-me-local-db-password

# Redis
TRUSTKART_REDIS_HOST=localhost
TRUSTKART_REDIS_PORT=6380
TRUSTKART_REDIS_PASSWORD=change-me-local-redis-password

# Auth: HMAC key for signing short-lived access tokens (at least 32 bytes, base64)
TRUSTKART_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Comma-separated browser origins allowed to call the API with credentials
TRUSTKART_ALLOWED_ORIGINS=http://localhost:5173

# Profile: dev enables Swagger UI and seeds the demo catalog
SPRING_PROFILES_ACTIVE=dev

# Optional (Phase 9): semantic search provider. Leave empty to run with exact search only.
TRUSTKART_AI_API_KEY=

# Frontend dev server: where Vite proxies /api
VITE_API_PROXY_TARGET=http://localhost:8080
